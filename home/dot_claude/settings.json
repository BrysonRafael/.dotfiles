{
  "permissions": {
    "allow": [
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(nvim:*)",
      "Bash(grep:*)",
      "Bash(gem list:*)",
      "Bash(bundle info:*)",
      "Read(~/Code/**)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(nc *)",
      "Bash(netcat *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(pco console *)",
      "Bash(pco connect *)",
      "Bash(pco dbconnect *)",
      "Bash(pco ssm *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.env.local)",
      "Read(.npmrc)",
      "Read(.bundle/config)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*_rsa)",
      "Read(**/*_dsa)",
      "Read(**/*_ecdsa)",
      "Read(**/*_ed25519)",
      "Read(**/.ssh/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.env.local)",
      "Edit(.npmrc)",
      "Edit(.bundle/config)",
      "Edit(**/secrets/**)",
      "Edit(**/.secrets/**)",
      "Edit(**/credentials*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ],
    "ask": [
      "Bash(pco *)",
      "Bash(chmod *)",
      "Bash(git reset --hard )",
      "Bash(git clean -fd *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "fable",
  "skillOverrides": {
    "docs": "off",
    "docx": "off",
    "google-workspace": "off",
    "import-memory": "off",
    "morning": "off",
    "pdf": "off",
    "pptx": "off",
    "skill-creator": "off",
    "xlsx": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/devbox-enforce.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/brysonrafael/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "pr@planning-center": true,
    "redshift-mcp@planning-center": true,
    "sentry@planning-center": false,
    "circleci@planning-center": true,
    "cloud-agent@planning-center": true,
    "expo@claude-plugins-official": true,
    "claude-md-toolkit@planning-center": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "theme": "auto",
  "preferredNotifChannel": "ghostty",
  "agentPushNotifEnabled": true
}
